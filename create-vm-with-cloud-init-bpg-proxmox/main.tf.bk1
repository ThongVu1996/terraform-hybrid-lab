# 1. Dùng Data Source để dò tìm máy ảo theo Tên (String)
data "proxmox_virtual_environment_vms" "ubuntu_template" {
  node_name = var.proxmox_node_thong

  filter {
    name   = "name"
    values = [var.proxmox_template_name]
  }
}

# 2. Tự động tạo file Cloud-init Snippet trên Proxmox qua API
resource "proxmox_virtual_environment_file" "mysql_config" {
  content_type = "snippets"
  datastore_id = "local"
  node_name    = var.proxmox_node_thong

  source_raw {
    file_name = "mysql-init-${var.db_name_thong}.yml"
    data      = <<-EOF
      #cloud-config
      # --- PHẦN BẢO MẬT & QUẢN LÝ LOG ---
      # 1. Tắt hiển thị SSH Host Key Fingerprints ra màn hình console
      ssh_fp_console: false
      
      # 2. Điều hướng toàn bộ log cài đặt vào file nội bộ bên trong VM
      output: { all: ">> /var/log/cloud-init-internal.log" }

      users:
        - name: thong
          groups: sudo
          shell: /bin/bash
          sudo: ALL=(ALL) NOPASSWD:ALL
          lock_passwd: false
          # Bọc biến mật khẩu trong dấu nháy kép để tránh lỗi ký tự đặc biệt
          password: "${var.ssh_password}"

      packages:
        - mysql-server

      runcmd:
        # In tiến trình ra console cho Dev xem (chỉ hiện những gì an toàn)
        - [ sh, -c, "echo '--- [1/4] Toi uu he thong & Repo... ---' > /dev/console" ]
        - sed -i "s/[a-z]*.archive.ubuntu.com/vn.archive.ubuntu.com/g" /etc/apt/sources.list
        - apt-get update -y -qq

        - [ sh, -c, "echo '--- [2/4] Mo khoa SSH Password... ---' > /dev/console" ]
        - sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config
        - sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config
        - systemctl restart ssh

        - [ sh, -c, "echo '--- [3/4] Cai dat & Kich hoat Tailscale... ---' > /dev/console" ]
        - curl -fsSL https://tailscale.com/install.sh | sh
        
        # CHỐT CHẶN BẢO MẬT: Dùng nháy đơn bọc lệnh và đẩy output vào /dev/null để giấu Key
        - 'tailscale up --authkey=${var.tailscale_auth_key} --hostname=mysql-lab-thong --ssh > /dev/null 2>&1'

        - [ sh, -c, "echo '--- [4/4] Cau hinh MySQL... ---' > /dev/console" ]
        - systemctl enable --now mysql
        - sleep 5
        - mysql -e "CREATE DATABASE IF NOT EXISTS ${var.db_name_thong};"
        - mysql -e "CREATE USER IF NOT EXISTS '${var.db_user_thong}'@'%' IDENTIFIED BY '${var.db_password_thong}';"
        - mysql -e "GRANT ALL PRIVILEGES ON ${var.db_name_thong}.* TO '${var.db_user_thong}'@'%';"
        - mysql -e "FLUSH PRIVILEGES;"
        
        - [ sh, -c, "echo '=== SETUP COMPLETED SUCCESSFULLY ===' > /dev/console" ]
    EOF
  }
}

# 3. Tạo máy ảo và gán file cấu hình
resource "proxmox_virtual_environment_vm" "mysql_node" {
  name      = "vm-mysql-zero-touch"
  node_name = var.proxmox_node_thong

  clone {
    vm_id = data.proxmox_virtual_environment_vms.ubuntu_template.vms[0].vm_id
  }

  initialization {
    ip_config {
      ipv4 {
        address = "172.199.10.150/24"
        gateway = "172.199.10.1"
      }
    }
    user_data_file_id = proxmox_virtual_environment_file.mysql_config.id
  }

  cpu {
    cores = 2
  }

  memory {
    dedicated = 4096
  }

  network_device {
    bridge = "vmbr0"
  }
}
